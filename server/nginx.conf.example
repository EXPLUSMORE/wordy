# Beispiel für eine eigene Subdomain, z. B. wordy.explusmore.com (Zertifikat über certbot).
server {
    listen 443 ssl http2;
    server_name wordy.explusmore.com;
    # ssl_certificate / ssl_certificate_key: von certbot eingetragen

    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server { listen 80; server_name wordy.explusmore.com; return 301 https://$host$request_uri; }
