# Kopie als .env speichern und anpassen. Die Datei NICHT ins Git einchecken.
PORT=8787
HOST=127.0.0.1
# Eltern-Zugang zum Dashboard (Benutzername und ein langes Passwort, mindestens 10 Zeichen)
ADMIN_USER=eltern
ADMIN_PASSWORD=bitte-ein-langes-eigenes-passwort
# Adresse(n) der App, damit der Browser die Daten senden darf (mehrere mit Komma). Die App läuft unter https://wordy.explusmore.com (GitHub Pages):
ALLOW_ORIGIN=https://wordy.explusmore.com
# Datenbankdatei (wird angelegt)
DB_FILE=/var/lib/wordy/wordy.db
# 1, wenn der Server hinter nginx steht (dann wird die echte Adresse aus X-Forwarded-For gelesen)
TRUST_PROXY=1
# Zeitzone für die Tagesauswertung
TZ_DISPLAY=Europe/Berlin

# --- Wochenmail (optional): jede Woche eine Zusammenfassung per Mail ---
# Ohne SMTP_HOST, MAIL_FROM und MAIL_TO wird keine Mail verschickt.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587              # 587 = STARTTLS, 465 = gesicherte Verbindung
# SMTP_USER=benutzername
# SMTP_PASSWORD=passwort
# MAIL_FROM=Wordy <wordy@explusmore.com>
# MAIL_TO=info@explusmore.com
# MAIL_DAY=0                 # 0 = Sonntag, 1 = Montag, ... 6 = Samstag
# MAIL_HOUR=18               # Uhrzeit (Zeitzone TZ_DISPLAY)

# --- Alternative für Microsoft 365: Versand über Microsoft Graph (empfohlen, ohne SMTP-Passwort) ---
# Statt der SMTP_*-Zeilen. MAIL_FROM ist das Postfach, aus dem gesendet wird (nur die Adresse, z. B. info@firma.de).
# GRAPH_TENANT=Verzeichnis-ID (Mandanten-ID)
# GRAPH_CLIENT_ID=Anwendungs-ID (Client-ID)
# GRAPH_CLIENT_SECRET=Geheimer Clientschlüssel (Wert)

# Adresse des Dashboards, die in der Wochenmail verlinkt wird
# DASHBOARD_URL=https://track.wordy.explusmore.com
