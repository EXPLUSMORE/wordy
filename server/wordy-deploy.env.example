# Als /etc/default/wordy-deploy speichern (optional). Ohne diese Datei gelten die Standardwerte.
# branch = jeder neue Stand auf main geht live (nach Selbsttest, mit automatischem Zurückrollen)
# tag    = nur Stände mit einem Tag wie server-2.7.0 gehen live (du gibst frei)
DEPLOY_MODE=branch
DEPLOY_BRANCH=main
#DEPLOY_TAG_GLOB=server-*
# Nur-Lesen-Deploy-Schlüssel (nur bei privatem Repository nötig)
#DEPLOY_KEY=/etc/wordy-deploy/id_ed25519
#NODE_BIN=/usr/bin/node
