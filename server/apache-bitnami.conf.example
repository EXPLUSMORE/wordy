# Für Server mit Bitnami-Apache (/opt/bitnami/apache). Als eigene Datei ablegen, z. B.
#   /opt/bitnami/apache/conf/vhosts/wordy-track.conf
# und NUR nach "apachectl configtest" mit "graceful" neu laden (kein Neustart, laufende Anfragen anderer Seiten bleiben unberührt).
# Die beiden Blöcke betreffen ausschließlich den Namen track.wordy.explusmore.com, andere Seiten bleiben wie sie sind.

<VirtualHost *:80>
    ServerName track.wordy.explusmore.com
    DocumentRoot "/opt/bitnami/apache/htdocs/wordy-acme"
    <Directory "/opt/bitnami/apache/htdocs/wordy-acme">
        Require all granted
    </Directory>
    # Zertifikatsprüfung von Let's Encrypt zulassen, alles andere auf https umleiten
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

# Den https-Block erst einfügen, wenn das Zertifikat existiert (Schritt "Zertifikat" in der Anleitung).
<VirtualHost *:443>
    ServerName track.wordy.explusmore.com
    SSLEngine on
    SSLCertificateFile    "/etc/letsencrypt/live/track.wordy.explusmore.com/fullchain.pem"
    SSLCertificateKeyFile "/etc/letsencrypt/live/track.wordy.explusmore.com/privkey.pem"

    ProxyPreserveHost On
    # Eine vom Client mitgeschickte Adresse nie vertrauen, Apache setzt die echte selbst
    RequestHeader unset X-Forwarded-For
    ProxyPass        / http://127.0.0.1:8787/
    ProxyPassReverse / http://127.0.0.1:8787/
</VirtualHost>
